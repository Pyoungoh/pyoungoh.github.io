---
import DoseButlerLanding from '../../components/DoseButlerLanding.astro';
import todayImage from '../../assets/dosebutler/ko/01-today.png';
import historyImage from '../../assets/dosebutler/ko/02-history.png';
import medicationsImage from '../../assets/dosebutler/ko/03-medications.png';
import repeatImage from '../../assets/dosebutler/ko/04-repeat.png';
---

<DoseButlerLanding
  lang="ko"
  path="/dosebutler/"
  seoTitle="약당번 | 복약 알림과 기록"
  seoDescription="약당번은 정해진 시간에 복약 알림을 보내고, 탭 한 번으로 복용을 체크하고, 복용 기록을 확인할 수 있는 간단한 복약 알림 앱입니다."
  hero={{
    title: '약당번',
    lead: '복약 알림과 기록',
    paragraphs: [
      '정해진 시간에 알려 주고, 탭 한 번으로 복용을 체크하세요. 복잡한 설정 없이 매일 약을 챙길 수 있어요.',
      '하루 여러 번 먹는 약도, 격일로 먹는 약도 한 곳에서 관리하세요.',
      '복약 알림, 복약 체크, 복약 기록. 꼭 필요한 기능만 담았습니다.',
    ],
    image: todayImage,
    imageAlt: '시간순으로 오늘의 복약 목록을 보여 주는 약당번 화면',
  }}
  gallery={{
    title: '앱 화면',
    items: [
      {
        image: historyImage,
        alt: '복약 기록',
        title: '복약 기록',
        description: '전체 약 또는 선택한 약의 최근 30일·이번 주 복약 기록을 달력에서 확인하세요.',
      },
      {
        image: medicationsImage,
        alt: '약장',
        title: '약장',
        description: '등록한 약과 복용량을 한눈에 확인하세요.',
      },
      {
        image: repeatImage,
        alt: '반복 일정',
        title: '반복 일정',
        description: '매일, 요일별, 또는 며칠 간격으로 알림을 설정하세요.',
      },
    ],
  }}
  highlights={{
    title: '약당번으로 할 수 있는 일',
    lead: '매일 약을 챙기는 데 필요한 기능을 간단하게 모았습니다.',
    items: [
      { href: '/dosebutler/medication-reminder/', text: '정해진 시간에 복약 알림을 받으세요' },
      { href: '/dosebutler/daily-medication-checklist/', text: '오늘 먹을 약을 탭 한 번으로 체크하세요' },
      { href: '/dosebutler/medication-schedule/', text: '매일, 요일 반복, N일 간격 일정을 등록하세요' },
      { href: '/dosebutler/medication-history/', text: '전체 약과 개별 약의 복약 기록과 복용률을 확인하세요' },
      { href: '/dosebutler/pill-organizer/', text: '약의 모양과 색상, 복용량을 정리하세요' },
    ],
  }}
  trust={{
    title: '복잡함 없이 바로 쓸 수 있어요',
    text: '로그인 없이 바로 사용할 수 있습니다. 복약 정보는 내 기기에만 저장됩니다.',
  }}
  seo={{
    title: '복약 알림 앱이란?',
    intro: '복약 알림 앱은 약 먹을 시간을 알려 주고, 복용했는지 간단히 기록할 수 있게 도와주는 앱입니다. 매일 약이나 영양제를 챙기는 분께 유용합니다.',
    list: [
      '정해진 시간에 복약 알림 받기',
      '알림에서 복용 완료, 다시 알림, 건너뛰기 선택',
      '하루 여러 번 복용하는 약 일정 등록',
      '최근 30일·이번 주 전체 약과 개별 약의 복약 기록 확인',
    ],
    outro: '약당번은 이 기능들을 하나의 간단한 앱에 담아, 매일 약을 더 편하게 챙길 수 있도록 도와줍니다.',
  }}
  disclaimer={{
    title: '안내',
    text: '약당번은 복약 시간을 알려 주고 기록하는 도구이며, 의학적 조언이나 진단, 처방을 제공하지 않습니다. 약의 종류, 복용 방법, 복용량은 반드시 의사 또는 약사의 안내를 따르세요.',
  }}
  support={{
    title: '지원',
    privacyTitle: '개인정보 처리방침',
    privacyLabel: '개인정보 처리방침 보기',
    privacyHref: '/dosebutler/privacy/',
  }}
/>
