---
import FeatureDetailPage from '../../../components/FeatureDetailPage.astro';
import PillKeepDownloadCTA from '../../../components/PillKeepDownloadCTA.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import { loadPillKeepFeaturePage, pillKeepFeatureSlugs } from '../../../lib/pillkeep-content';
import { getPillKeepRelatedTools } from '../../../lib/site';

export async function getStaticPaths() {
  return pillKeepFeatureSlugs.map((feature) => ({
    params: { feature },
  }));
}

const { feature } = Astro.params;
const page = await loadPillKeepFeaturePage('ko', feature!);
---

<FeatureDetailPage
  title={page.title}
  description={page.description}
  lang="ko"
  currentPath={`/pillkeep/${feature}/`}
  backHref={page.backHref}
  backLabel={page.backLabel}
>
  <div set:html={page.introHtml} />

  {page.sections.map((section) => (
    <>
      <h2>{section.heading}</h2>
      <div set:html={section.html} />
    </>
  ))}

  <PillKeepDownloadCTA lang="ko" variant="detail" />
  <RelatedTools {...getPillKeepRelatedTools('ko', feature!)} />
</FeatureDetailPage>
